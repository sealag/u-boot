/dts-v1/;

#include "arm/nxp/imx/imx6ull.dtsi"

/ {
	model = "SEAL eMeter";
	compatible = "seal,emeter", "fsl,imx6ull";

	chosen {
		stdout-path = &uart5;
	};

	memory {
		reg = <0x80000000 0>;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;

		red {
			label = "red";
			gpios = <&gpio3 19 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		green {
			label = "green";
			gpios = <&gpio3 14 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		blue {
			label = "blue";
			gpios = <&gpio3 11 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

	};

	leds-fp {
		compatible = "gpio-leds";

		fp1 {
			label = "fp1";
			gpios = <&io_expander 0 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		fp2 {
			label = "fp2";
			gpios = <&io_expander 1 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 191000>;
		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <7>;
		power-supply = <&reg_3v3>;
		status = "okay";
	};

	pwrseq_wifi: pwrseq-wifi {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio5 8 GPIO_ACTIVE_LOW>;
		clocks = <&rtc 1>;
		clock-names = "ext_clock";
	};

	reg_3v3: reg-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "reg_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};
};

&ecspi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2>;
	status = "okay";

	num-cs = <1>;
	cs-gpios = <&gpio4 22 GPIO_ACTIVE_LOW>;

	panel@0 {
		compatible = "panel-mipi-dbi-spi";
		reg = <0>;
		backlight = <&backlight>;
		dc-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&io_expander 6 GPIO_ACTIVE_HIGH>;
		spi-max-frequency = <10000000>;
		power-supply = <&reg_3v3>;
		io-supply = <&reg_3v3>;

		width-mm = <41>;
		height-mm = <30>;

		timing: panel-timing {
			hactive = <320>;
			vactive = <240>;
			hback-porch = <0>;
			vback-porch = <0>;

			clock-frequency = <0>;
			hfront-porch = <0>;
			hsync-len = <0>;
			vfront-porch = <0>;
			vsync-len = <0>;
		};
	};
};

&ecspi4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi4>;
	cs-gpios = <&gpio2 15 GPIO_ACTIVE_LOW>;
	status = "okay";

	fram@0 {
		compatible = "cypress,fm25";
		spi-max-frequency = <20000000>;
		reg = <0>;
		size = <16384>;
	};
};

&clks {
	assigned-clocks = <&clks IMX6UL_CLK_ENET1_REF_SEL>;
	assigned-clock-parents = <&clks IMX6UL_CLK_ENET1_REF_125M>;
};

/*
&ecspi3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_ecspi3>;
	pinctrl-1 = <&pinctrl_ecspi3_sleep>;
	status = "okay";

	num-cs = <1>;
	cs-gpios = <&gpio1 20 GPIO_ACTIVE_LOW>;

	hdplc_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;
		vcc-supply = <&reg_3v3>;
	};
};
*/

&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet1>;
	phy-mode = "rmii";
	phy-supply = <&reg_3v3>;
	status = "okay";

	fixed-link {
		speed = <100>;
		full-duplex;
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	clock-frequency = <400000>;
	status = "okay";

	io_expander: io-expander@20 {
		compatible = "nxp,pcf8574";
		reg = <0x20>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	touchscreen@55 {
		compatible = "sitronix,st1624", "sitronix,st1633";
		reg = <0x55>;
		interrupt-parent = <&gpio3>;
		interrupts = <28 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_touch>;
		gpios = <&io_expander 7 GPIO_ACTIVE_LOW>;
		wakeup-source;
		touchscreen-inverted-x;
		touchscreen-swapped-x-y;
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	clock-frequency = <400000>;
	status = "okay";

	rtc: rtc@68 {
		#clock-cells = <1>;
		compatible = "maxim,ds3231";
		reg = <0x68>;
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c3>;
	clock-frequency = <400000>;
	status = "okay";
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_ecspi2: ecspi2grp {
		fsl,pins = <
			MX6UL_PAD_CSI_DATA00__ECSPI2_SCLK	0x1b020
			MX6UL_PAD_CSI_DATA02__ECSPI2_MOSI	0x1b020
			MX6UL_PAD_CSI_DATA03__ECSPI2_MISO	0x1b020
			/* LCD_CS */
			MX6UL_PAD_CSI_DATA01__GPIO4_IO22	0x1b020
			/* LCD_DC */
			MX6UL_PAD_GPIO1_IO07__GPIO1_IO07	0x1b020
		>;
	};

	pinctrl_ecspi3: ecspi3grp {
		fsl,pins = <
			MX6UL_PAD_UART2_RX_DATA__ECSPI3_SCLK	0x1b020
			MX6UL_PAD_UART2_RTS_B__ECSPI3_MISO	0x1b020
			MX6UL_PAD_UART2_CTS_B__ECSPI3_MOSI	0x1b020
			/* HDPLC_FLASH_CS_N */
			MX6UL_PAD_UART2_TX_DATA__GPIO1_IO20	0x1b020
		>;
	};

	pinctrl_ecspi3_sleep: ecspi3-sleepgrp {
		fsl,pins = <
			MX6UL_PAD_UART2_RX_DATA__ECSPI3_SCLK	0x0
			MX6UL_PAD_UART2_RTS_B__ECSPI3_MISO	0x0
			MX6UL_PAD_UART2_CTS_B__ECSPI3_MOSI	0x0
			/* HDPLC_FLASH_CS_N */
			MX6UL_PAD_UART2_TX_DATA__GPIO1_IO20	0x0
		>;
	};

	pinctrl_ecspi4: ecspi4grp {
		fsl,pins = <
			MX6UL_PAD_ENET2_TX_DATA1__ECSPI4_SCLK   0x1b020
			MX6UL_PAD_ENET2_TX_EN__ECSPI4_MOSI      0x1b020
			MX6UL_PAD_ENET2_TX_CLK__ECSPI4_MISO     0x1b020
			/* FRAM_CS_N */
			MX6UL_PAD_ENET2_RX_ER__GPIO2_IO15       0x1b020
		>;
	};

	pinctrl_enet1: enet1grp {
		fsl,pins = <
			MX6UL_PAD_ENET1_RX_EN__ENET1_RX_EN	0x1f0a9
			MX6UL_PAD_ENET1_RX_ER__ENET1_RX_ER	0x1b0a9
			MX6UL_PAD_ENET1_RX_DATA0__ENET1_RDATA00	0x1f0a9
			MX6UL_PAD_ENET1_RX_DATA1__ENET1_RDATA01	0x1f0a9
			MX6UL_PAD_ENET1_TX_EN__ENET1_TX_EN	0x1b0a9
			MX6UL_PAD_ENET1_TX_DATA0__ENET1_TDATA00	0x1b0a9
			MX6UL_PAD_ENET1_TX_DATA1__ENET1_TDATA01	0x1b0a9
			MX6UL_PAD_ENET1_TX_CLK__ENET1_REF_CLK1	0x4001b091
			/* HDPLC_RESET_N */
			MX6UL_PAD_LCD_DATA22__GPIO3_IO27	0x1f020
		>;
	};

	pinctrl_hog: hoggrp {
		fsl,pins = <
			/* RP2350_BOOT_N */
			MX6UL_PAD_UART4_TX_DATA__GPIO1_IO28	0x1f020
			/* RP2350_RESET_N */
			MX6UL_PAD_UART4_RX_DATA__GPIO1_IO29	0x1f020
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO02__I2C1_SCL		0x4001b8b0
			MX6UL_PAD_GPIO1_IO03__I2C1_SDA		0x4001b8b0
		>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO00__I2C2_SCL		0x4001b8b0
			MX6UL_PAD_GPIO1_IO01__I2C2_SDA		0x4001b8b0
		>;
	};

	pinctrl_i2c3: i2c3grp {
		fsl,pins = <
			MX6UL_PAD_ENET2_RX_DATA0__I2C3_SCL	0x4001b8b0
			MX6UL_PAD_ENET2_RX_DATA1__I2C3_SDA	0x4001b8b0
		>;
	};

	pinctrl_leds: ledsgrp {
		fsl,pins = <
			MX6UL_PAD_LCD_DATA14__GPIO3_IO19	0x1b0b0 /* Red */
			MX6UL_PAD_LCD_DATA09__GPIO3_IO14	0x1b0b0 /* Green */
			MX6UL_PAD_LCD_DATA06__GPIO3_IO11	0x1b0b0 /* Blue */
		>;
	};

	pinctrl_pwm1: pwm1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO08__PWM1_OUT		0x1b0b0
		>;
	};

	pinctrl_touch: touchgrp {
		fsl,pins = <
			/* TOUCH_INT */
			MX6UL_PAD_LCD_DATA23__GPIO3_IO28	0x1b0b0
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX	0x1b0b1
			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			MX6UL_PAD_UART3_TX_DATA__UART3_DCE_TX	0x1b0b1
			MX6UL_PAD_UART3_RX_DATA__UART3_DCE_RX	0x1b0b1
			MX6UL_PAD_UART3_RTS_B__UART3_DCE_RTS	0x1b0b1
			MX6UL_PAD_UART3_CTS_B__UART3_DCE_CTS	0x1b0b1
			/* BT_REG_ON */
			MX6UL_PAD_JTAG_TDI__GPIO1_IO13		0x1b0b1
		>;
	};

	pinctrl_uart4: uart4grp {
		fsl,pins = <
			MX6UL_PAD_LCD_CLK__UART4_DCE_TX		0x1b0b1
			MX6UL_PAD_LCD_ENABLE__UART4_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_uart5: uart5grp {
		fsl,pins = <
			MX6UL_PAD_UART5_TX_DATA__UART5_DCE_TX	0x1b0b1
			MX6UL_PAD_UART5_RX_DATA__UART5_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_uart8: uart8grp {
		fsl,pins = <
			MX6UL_PAD_LCD_DATA20__UART8_DCE_TX	0x1b0b1
			MX6UL_PAD_LCD_DATA21__UART8_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX6UL_PAD_SD1_CLK__USDHC1_CLK		0x17070
			MX6UL_PAD_SD1_CMD__USDHC1_CMD		0x10070
			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0	0x17070
			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1	0x17070
			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2	0x17070
			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3	0x17070
			/* WL_REG_ON */
			MX6UL_PAD_SNVS_TAMPER8__GPIO5_IO08	0x13070
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX6UL_PAD_NAND_RE_B__USDHC2_CLK		0x17070
			MX6UL_PAD_NAND_WE_B__USDHC2_CMD		0x10070
			MX6UL_PAD_NAND_DATA00__USDHC2_DATA0	0x17070
			MX6UL_PAD_NAND_DATA01__USDHC2_DATA1	0x17070
			MX6UL_PAD_NAND_DATA02__USDHC2_DATA2	0x17070
			MX6UL_PAD_NAND_DATA03__USDHC2_DATA3	0x17070
			MX6UL_PAD_NAND_DATA04__USDHC2_DATA4	0x17070
			MX6UL_PAD_NAND_DATA05__USDHC2_DATA5	0x17070
			MX6UL_PAD_NAND_DATA06__USDHC2_DATA6	0x17070
			MX6UL_PAD_NAND_DATA07__USDHC2_DATA7	0x17070
			MX6UL_PAD_NAND_ALE__USDHC2_RESET_B	0x17070
		>;
	};
};

&pwm1 {
	#pwm-cells = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm1>;
	status = "okay";
};

/* M-Bus */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
	fsl,inverted-tx;
	fsl,inverted-rx;
};

/* Bluetooth */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	uart-has-rtscts;
	status = "okay";

	bluetooth: bluetooth {
		compatible = "infineon,cyw43439-bt", "brcm,bcm4329-bt";
		shutdown-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		vbat-supply = <&reg_3v3>;
		vddio-supply = <&reg_3v3>;
	};
};

/* M-Bus STM32 MCU */
&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	status = "okay";
};

/* Console */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	status = "okay";
};

/* HD-PLC */
&uart8 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart8>;
	status = "okay";
};

&usbotg1 {
	dr_mode = "peripheral";
	disable-over-current;
	status = "okay";
};

&usbotg2 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <4>;
	no-1-8-v;
	non-removable;
	mmc-pwrseq = <&pwrseq_wifi>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	wifi@1 {
		reg = <1>;
		compatible = "infineon,cyw43439-fmac", "brcm,bcm4329-fmac";
	};
};

&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	bus-width = <8>;
	no-1-8-v;
	non-removable;
	status = "okay";
};
